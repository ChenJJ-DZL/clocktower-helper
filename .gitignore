# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 临时目录
/logs/
/temp/

# 数据生成目录（可选的生成数据）
/data/

# 其他临时文件
*.log
*.tmp
*.temp
playwright-report/
test-results/
.me
screenshots/

# rule conformance generated artifacts (baseline 提交，其余为可再生产物)
/outputs/rule_conformance/official_spec.json
/outputs/rule_conformance/ledger.json
/outputs/rule_conformance/report.md

/outputs/rule_conformance/examples_ledger.json
/outputs/rule_conformance/semantic_findings.json
/outputs/rule_conformance/mutation_report.json
/outputs/rule_conformance/fuzz_report.json
/outputs/rule_conformance/e2e_assertions.json
/outputs/_*.json

